{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        org.babashka/sci {:mvn/version "0.9.44"}
        org.clojure/data.json {:mvn/version "2.5.1"}}
 :aliases
 {:test {:extra-paths ["test"]
         :jvm-opts ["-Drlm.sut=native"]
         :main-opts ["-m" "rlm.test-runner"]}
  :test-native {:extra-paths ["test"]
                :jvm-opts ["-Drlm.sut=native"]
                :main-opts ["-m" "rlm.test-runner"]}
  :test-jvm {:extra-paths ["test"]
             :jvm-opts ["-Drlm.sut=jvm"]
             :main-opts ["-m" "rlm.test-runner"]}}}
